# =============================================================================
# AI-Powered Credit Risk Intelligence Platform — Environment Configuration
# Copy this file to `.env` and fill in values as needed.
# Never commit your real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (Talk-to-Data module)
# -----------------------------------------------------------------------------
# "mock"      -> Deterministic, rule-based NL-to-SQL. No API key or cost required.
#                Use this for offline development, testing, and grading without
#                API billing configured.
# "anthropic" -> Real LLM-powered NL-to-SQL using the Anthropic API.
#                Requires ANTHROPIC_API_KEY and active API billing.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model string — set to whatever model your Anthropic account has access to.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Max tokens for LLM responses (SQL generation / business answers are short)
ANTHROPIC_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# Dataset Configuration
# -----------------------------------------------------------------------------
# Path to the raw Home Credit application_train.csv (see README "Dataset Setup")
RAW_DATA_PATH=data/raw/application_train.csv
# Path to the Home Credit feature description reference file
COLUMN_DESCRIPTION_PATH=data/raw/HomeCredit_columns_description.csv
# Path where cleaned/processed data is written
PROCESSED_DATA_PATH=data/processed/applicants_processed.csv

# Optional row cap for fast local iteration. Leave empty ("") to use the FULL
# dataset (recommended for final training). Example: 50000 for quick dev runs.
DATA_SAMPLE_SIZE=

# Random seed used everywhere for reproducibility
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Model Artifacts
# -----------------------------------------------------------------------------
MODEL_DIR=models
MODEL_FILENAME=credit_risk_pipeline.joblib
FEATURE_METADATA_FILENAME=feature_metadata.json

# -----------------------------------------------------------------------------
# Risk Band Thresholds (documented + justified in README Section 10)
# Probability >= HIGH_RISK_THRESHOLD          -> HIGH
# MEDIUM_RISK_THRESHOLD <= prob < HIGH         -> MEDIUM
# prob < MEDIUM_RISK_THRESHOLD                 -> LOW
# -----------------------------------------------------------------------------
MEDIUM_RISK_THRESHOLD=0.30
HIGH_RISK_THRESHOLD=0.60

# -----------------------------------------------------------------------------
# Database (Talk-to-Data module)
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=data/processed/credit_risk.db

# -----------------------------------------------------------------------------
# Conversation Memory (Talk-to-Data module)
# -----------------------------------------------------------------------------
# Number of previous chat turns retained for follow-up question context
CONVERSATION_MEMORY_TURNS=3

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
