# --- Environment & secrets ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Dataset (never commit raw/processed data) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Trained model artifacts (regenerated via training pipeline) ---
models/*
!models/.gitkeep

# --- SQLite database (generated at setup/runtime) ---
*.db
*.sqlite
*.sqlite3

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Docker ---
docker-compose.override.yml
